# Local CPA / CLI proxy compatible with the OpenAI API.
# Do not commit real keys. Put secrets in .env locally or Railway Variables.
OPENAI_BASE_URL=http://127.0.0.1:8318/v1
OPENAI_API_KEY=

# Default text model for orchestration and content generation.
DEFAULT_TEXT_MODEL=gpt-5.4

# Optional faster/cheaper model for lightweight helper tasks.
FAST_TEXT_MODEL=gpt-5.4-mini

# Default image model.
DEFAULT_IMAGE_MODEL=gpt-image-2
